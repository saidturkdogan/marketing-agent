# ── Required ──────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Optional: override defaults ───────────────────────
GOOGLE_MODEL=gemini-2.0-flash
POSTGRES_PASSWORD=secret

# ── Local-only (ignored when using docker-compose) ────
DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5432/marketing_agent
REDIS_URL=redis://localhost:6379/0

# ── Publisher API keys (optional) ─────────────────────

# Twitter/X (Get from: https://developer.twitter.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn (Get from: https://www.linkedin.com/developers/apps)
# Run: python scripts/linkedin_oauth_setup.py to generate token
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:8080/linkedin/callback
LINKEDIN_ACCESS_TOKEN=

# Instagram/Meta (Get from: https://developers.facebook.com/)
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# WordPress (Your self-hosted WordPress site)
WP_URL=https://yourblog.com
WP_USERNAME=
WP_APPLICATION_PASSWORD=
